rules_version = '2';

// Public site reads every collection with no login required (that's how
// visitors see your portfolio). Writes require Firebase Auth — and since
// this project has no public sign-up page, the only account that can ever
// exist is the one admin user you create yourself in the Firebase Console
// (Authentication > Users > Add user). That's what gates /admin.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{collection}/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
